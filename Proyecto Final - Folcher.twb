      <column caption='Ganancia' datatype='real' default-format='c&quot;$ &quot;#,##0;-&quot;$ &quot;#,##0' name='[Calculation_0227082930925572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0227082930503682] - [Calculation_0227082930769923]' />
