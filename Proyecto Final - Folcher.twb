      <column caption='Ventas Totales' datatype='real' default-format='c&quot;$ &quot;#,##0;-&quot;$ &quot;#,##0' name='[Calculation_0227082930503682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Quantity]) * ZN([Unit Price USD])' />
      </column>
      <column caption='Costo Total' datatype='real' default-format='c&quot;$ &quot;#,##0;-&quot;$ &quot;#,##0' name='[Calculation_0227082930769923]' role='measure' type='quantitative'>
