    <dashboard enable-sort-zone-taborder='true' name='Documentación'>
      <style />
      <size maxheight='800' maxwidth='1800' minheight='800' minwidth='1800' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='10' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='9' is-scaled='1' param='C:/Users/usuario/Downloads/Group 1 (3).jpg' type-v2='bitmap' w='100000' x='0' y='0'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='57250' id='5' is-centered='0' is-scaled='1' param='C:/Users/usuario/Downloads/Gemini_Generated_Image_ie3y9kie3y9kie3y.png' type-v2='bitmap' w='33667' x='-2667' y='5375' />
        <zone forceUpdate='true' h='30125' id='8' type-v2='text' w='17111' x='5167' y='59500'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#33afbb' fontsize='20'>OBJETIVO</run>
            <run fontalignment='1'>Æ&#10;&#10;</run>
            <run fontalignment='1' fontcolor='#142232' fontname='Benton Sans Book' fontsize='12'>Evaluar la rentabilidad global, el comportamiento de las ventas y el rendimiento del catálogo de productos para identificar categorías críticas, optimizar márgenes de ganancia y apoyar la toma de decisiones estratégicas.</run>
          </formatted-text>
        </zone>
        <zone h='10750' id='11' is-scaled='1' param='C:/Users/usuario/Downloads/target_182146.png' type-v2='bitmap' w='5056' x='11167' y='50375' />
        <zone forceUpdate='true' h='34625' id='12' type-v2='text' w='15889' x='26222' y='11250'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#33afbb' fontsize='20'>FUENTE DE DATOS</run>
            <run fontalignment='1'>Æ&#10;&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>El análisis utiliza la base de datos pública Global Electronics Retail, obtenida de la plataforma Kaggle. Se trata de un modelo relacional multitabla que integra transacciones de ventas, catálogo de productos, registro de clientes y ubicaciones de tiendas. El conjunto de datos reúne más de 15 columnas con cobertura completa de tipos de datos texto, fecha, atributos geográficos y métricas numéricas.</run>
          </formatted-text>
        </zone>
        <zone h='8000' id='13' is-scaled='1' param='C:/Users/usuario/Downloads/data-management_12504305.png' type-v2='bitmap' w='4111' x='32167' y='6375' />
        <zone h='19375' id='14' type-v2='text' w='15722' x='26389' y='60750'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#33afbb' fontsize='20'>USUARIOS</run>
            <run fontalignment='1'>Æ&#10;&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Gerencia General, Directores de Operaciones, Analistas de Business Intelligence y Responsables de Producto/Inventario.</run>
          </formatted-text>
        </zone>
        <zone h='9875' id='15' is-scaled='1' param='C:/Users/usuario/Downloads/team_8914477.png' type-v2='bitmap' w='5333' x='31444' y='50375' />
        <zone forceUpdate='true' h='30875' id='16' type-v2='text' w='16000' x='45611' y='10375'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#33afbb' fontsize='20'>MODELO RELACIONAL</run>
            <run fontalignment='1'>Æ&#10;&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Modelo donde la tabla de hechos Sales se vincula mediante claves foráneas a las dimensiones:</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>-Products (vía </run>
            <run fontalignment='1' fontcolor='#000000' fontname='Courier New' fontsize='12'>ProductKey</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>)</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>-Customers (vía </run>
            <run fontalignment='1' fontcolor='#000000' fontname='Courier New' fontsize='12'>CustomerKey</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>)</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>-Stores (vía </run>
            <run fontalignment='1' fontcolor='#000000' fontname='Courier New' fontsize='12'>StoreKey</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>)</run>
          </formatted-text>
        </zone>
        <zone h='8500' id='17' is-scaled='1' param='C:/Users/usuario/Pictures/Screenshots/Captura de pantalla 2026-08-18 011903.png' type-v2='bitmap' w='5167' x='51056' y='6000' />
        <zone forceUpdate='true' h='25250' id='18' type-v2='text' w='15778' x='45500' y='59750'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#33afbb' fontsize='20'>CAMPOS CALCULADOS</run>
            <run fontalignment='1'>Æ&#10;&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>- Márgen de ganancias</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>- Ventas Totales</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>- Cantidad de clientes</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>- Cantidad de pedidos</run>
          </formatted-text>
        </zone>
        <zone h='10125' id='19' is-scaled='1' param='C:/Users/usuario/Pictures/Screenshots/Captura de pantalla 2026-08-18 012530.png' type-v2='bitmap' w='4333' x='51111' y='50625' />
        <zone h='26875' id='20' type-v2='text' w='13667' x='66278' y='16375'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#33afbb' fontsize='20'>PARÁMETRO</run>
            <run fontalignment='1'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>Parámetro Selección de Métrica:</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'> Parámetro de tipo cadena de texto que permite alternar dinámicamente las vistas del tablero entre </run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12' italic='true'>Ventas Totales</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>, </run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12' italic='true'>Ganancia</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>, </run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12' italic='true'>Pedidos Únicos</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'> y </run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12' italic='true'>Clientes Únicos</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>.</run>
