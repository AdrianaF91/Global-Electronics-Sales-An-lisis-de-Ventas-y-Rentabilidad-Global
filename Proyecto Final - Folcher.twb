      </column>
      <column caption='Métrica' datatype='real' name='[Calculation_0393385224163331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 0393385115582466]&#13;&#10;  WHEN &quot;Ventas Totales&quot; THEN SUM([Calculation_0227082930503682])&#13;&#10;  WHEN &quot;Ganancia&quot; THEN SUM([Calculation_0227082930925572])&#13;&#10;  WHEN &quot;Unidades Vendidas&quot; THEN SUM([Quantity])&#13;&#10;  WHEN &quot;Cantidad de clientes&quot; THEN [Calculation_0393385229504517]&#13;&#10;END' />
